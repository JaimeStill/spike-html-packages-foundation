{
  "name": "@jaimestill/spike-html-packages-foundation",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./css": {
      "types": "./dist/css.d.ts"
    },
    "./css.js": null,
    "./format.js": {
      "types": "./dist/format.d.ts"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.css": "./dist/*.css"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.1",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
